lib_path = Pathname.new(__FILE__).parent.parent.join('lib').realpath.to_s
$LOAD_PATH.unshift(lib_path) unless $LOAD_PATH.include?(lib_path)

$scheme = ENV.fetch("SCHEME", "http")
$port = ENV.fetch("PORT", 8282).to_i
$host = ENV.fetch("HOST", "localhost:#{$port}")

Warden::Manager.serialize_into_session do |user|
  user.id
end

Warden::Manager.serialize_from_session do |id|
  ::Authn::User.find(id)
end

Warden::Strategies.add(:password) do
  def valid?
    params['username'] && params['password']
  end

  def authenticate!
    user = ::Authn::User.login(params.transform_keys(&:to_sym))
    user.nil? ? fail!("Could not log in") : success!(user)
  end
end

module HTTPHelpers
  def current_user?(request)
    request.env['warden'].authenticated?
  end

  def current_user(request)
    request.env['warden'].user
  end

  def default_headers
    {
      'X-Powered-By' => 'IdP'
    }
  end

  def http_not_found
    [404, default_headers, []]
  end

  def http_ok(headers = {}, body = nil)
    [200, default_headers.merge(headers), [body]]
  end

  def http_redirect_to(location)
    [302, { 'Location' => "#{$scheme}://#{$host}#{location}" }, []]
  end
end

module Scim
  COMPARATORS = {
    eq: ->(value, target) { value.casecmp?(target) },
    ne: ->(value, target) { !value.casecmp?(target) },
    co: ->(value, target) { value.downcase.include?(target.downcase) },
    sw: ->(value, target) { value.downcase.start_with?(target.downcase) },
    ew: ->(value, target) { value.downcase.end_with?(target.downcase) },
    gt: ->(value, target) { value > target },
    ge: ->(value, target) { value >= target },
    lt: ->(value, target) { value < target },
    le: ->(value, target) { value <= target },
  }.freeze

  class PatchError < StandardError
    attr_reader :scim_type, :status

    def initialize(message, scim_type: nil, status: 400)
      super(message)
      @scim_type = scim_type
      @status = status
    end
  end

  class Search
    def initialize(clazz)
      @clazz = clazz
    end

    def for(filter)
      return @clazz.all if filter.blank?

      Scim.parse_filter(filter).accept(Scim::Visitor.new(@clazz))
    end
  end

  class Visitor < Scim::Kit::V2::Filter::Visitor
    def initialize(clazz)
      @clazz = clazz
    end

    COMPARATORS.each do |operator, comparator|
      define_method(Scim::Kit::V2::Filter::Visitor::VISITORS.fetch(operator)) do |node|
        select_by(node) { |value| comparator.call(value.to_s, node.value) }
      end
    end

    def visit_presence(node)
      select_by(node) { |value| value.present? }
    end

    def visit_and(node)
      visit(node.left) & visit(node.right)
    end

    def visit_or(node)
      visit(node.left) | visit(node.right)
    end

    private

    def select_by(node)
      attribute = @clazz.scim_attribute_for(node.attribute)
      return [] if attribute.nil?

      @clazz.all.select { |record| yield record[attribute] }
    end
  end

  def self.attribute_key(name)
    name.to_s.underscore.to_sym
  end

  def self.parse_filter(filter)
    ::Scim::Kit::V2::Filter.parse(filter)
  rescue ::Scim::Kit::Error
    raise
  rescue StandardError
    raise ::Scim::Kit::Error, "invalid filter: #{filter}"
  end

  class FilterMatcher < Scim::Kit::V2::Filter::Visitor
    def self.matches?(hash, filter_or_node)
      node = filter_or_node.is_a?(String) ? Scim.parse_filter(filter_or_node) : filter_or_node
      new(hash).visit(node)
    end

    def initialize(hash)
      @hash = hash
    end

    COMPARATORS.each do |operator, comparator|
      define_method(Scim::Kit::V2::Filter::Visitor::VISITORS.fetch(operator)) do |node|
        comparator.call(@hash[Scim.attribute_key(node.attribute)].to_s, node.value)
      end
    end

    def visit_presence(node)
      @hash[Scim.attribute_key(node.attribute)].present?
    end

    def visit_and(node)
      visit(node.left) && visit(node.right)
    end

    def visit_or(node)
      visit(node.left) || visit(node.right)
    end
  end

  class PatchPath
    PATTERN = %r{\A(?<attribute>[A-Za-z][\w]*)(?:\[(?<filter>.+)\])?(?:\.(?<sub_attribute>[A-Za-z][\w]*))?\z}

    attr_reader :attribute, :filter, :sub_attribute

    def initialize(path)
      match = PATTERN.match(path.to_s)
      raise ::Scim::Kit::Error, "invalid path: #{path}" if match.nil?

      @attribute = Scim.attribute_key(match[:attribute])
      @filter = match[:filter]
      @sub_attribute = match[:sub_attribute] && Scim.attribute_key(match[:sub_attribute])
    end

    def filtered?
      !filter.nil?
    end

    def filter_node
      @filter_node ||= Scim.parse_filter(filter)
    end
  end

  class PatchOp
    USER_RULES = {
      mutable: %i[user_name active name emails roles external_id],
      ignored: %i[id meta schemas],
      unsupported: %i[password],
      required: %i[user_name],
      multi_valued: %i[emails roles],
    }.freeze
    GROUP_RULES = {
      mutable: %i[display_name members external_id],
      ignored: %i[id meta schemas],
      unsupported: [],
      required: %i[display_name],
      multi_valued: %i[members],
    }.freeze

    def self.apply(state, operations, rules: USER_RULES)
      patch = new(state, rules)
      operations.each { |operation| patch.apply_one(operation) }
      patch.state
    end

    attr_reader :state

    def initialize(state, rules = USER_RULES)
      @state = state.deep_dup
      @rules = rules
    end

    def apply_one(operation)
      case operation[:op].to_s.downcase
      when "add" then write(operation[:path], operation[:value], replace: false)
      when "replace" then write(operation[:path], operation[:value], replace: true)
      when "remove" then erase(operation[:path])
      else
        raise ::Scim::PatchError.new("unsupported PATCH op: #{operation[:op]}", scim_type: "invalidValue")
      end
    end

    private

    def write(path, value, replace:)
      if path.blank?
        raise ::Scim::PatchError.new("value must be an object", scim_type: "invalidValue") unless value.is_a?(Hash)

        value.each { |key, val| write(key.to_s, val, replace: replace) }
        return
      end

      target = ::Scim::PatchPath.new(path)
      return if ignored?(target.attribute)

      assert_mutable!(target.attribute)

      if @rules[:multi_valued].include?(target.attribute)
        write_multi_valued(target, value, replace: replace)
      else
        patch = target.sub_attribute ? { target.sub_attribute => value } : value
        @state[target.attribute] = patch.is_a?(Hash) ? (@state[target.attribute] || {}).merge(underscore_keys(patch)) : patch
      end
    end

    def erase(path)
      raise ::Scim::PatchError.new("path is required for remove", scim_type: "noTarget") if path.blank?

      target = ::Scim::PatchPath.new(path)
      return if ignored?(target.attribute)

      assert_mutable!(target.attribute)
      if @rules[:required].include?(target.attribute)
        raise ::Scim::PatchError.new("#{target.attribute} is required", scim_type: "mutability")
      end

      if @rules[:multi_valued].include?(target.attribute)
        erase_multi_valued(target)
      elsif target.sub_attribute
        @state[target.attribute]&.delete(target.sub_attribute)
      else
        @state[target.attribute] = nil
      end
    end

    def write_multi_valued(target, value, replace:)
      array = (@state[target.attribute] ||= [])

      if target.filtered?
        node = target.filter_node
        array.each do |item|
          next unless ::Scim::FilterMatcher.matches?(item, node)

          if target.sub_attribute
            item[target.sub_attribute] = value
          elsif replace
            item.replace(underscore_keys(value))
          else
            item.merge!(underscore_keys(value))
          end
        end
      elsif replace
        @state[target.attribute] = Array.wrap(value).map { |item| underscore_keys(item) }
      else
        additions = Array.wrap(value).map { |item| underscore_keys(item) }
        array.concat(additions.reject { |item| array.include?(item) })
      end

      normalize_primary!(target.attribute)
    end

    def erase_multi_valued(target)
      array = @state[target.attribute]
      return if array.nil?

      unless target.filtered?
        @state[target.attribute] = []
        return
      end

      node = target.filter_node
      array.reject! { |item| ::Scim::FilterMatcher.matches?(item, node) }
      array.each { |item| item.delete(target.sub_attribute) } if target.sub_attribute
    end

    def normalize_primary!(attribute)
      array = @state[attribute]
      return unless array.is_a?(Array)

      primary_index = array.rindex { |item| item[:primary] == true }
      return if primary_index.nil?

      array.each_with_index do |item, index|
        item[:primary] = false if index != primary_index && item.key?(:primary)
      end
    end

    def underscore_keys(hash)
      unless hash.is_a?(Hash)
        raise ::Scim::PatchError.new("expected an object value", scim_type: "invalidValue")
      end

      hash.transform_keys { |key| Scim.attribute_key(key) }
    end

    def ignored?(attribute)
      @rules[:ignored].include?(attribute)
    end

    def assert_mutable!(attribute)
      return if @rules[:mutable].include?(attribute)

      if @rules[:unsupported].include?(attribute)
        raise ::Scim::PatchError.new("#{attribute} is not mutable", scim_type: "mutability")
      end

      raise ::Scim::PatchError.new("unknown attribute: #{attribute}", scim_type: "invalidPath")
    end
  end

  class Client
    Response = Struct.new(:status, :body) do
      def success?
        (200..299).cover?(status)
      end

      def resource
        parsed = JSON.parse(body.to_s, symbolize_names: true)
        parsed.is_a?(Hash) ? parsed : {}
      rescue JSON::ParserError
        {}
      end
    end

    def initialize(base_url, token)
      @base_url = base_url.to_s.chomp("/")
      headers = {
        "Accept" => "application/scim+json",
        "Content-Type" => "application/scim+json",
      }
      headers["Authorization"] = "Bearer #{token}" if token.present?
      @http = Net::Hippie::Client.new(headers: headers)
    end

    def get(path, params = {})
      uri = uri_for(path)
      uri.query = URI.encode_www_form(params) if params.any?
      execute { |http| http.get(uri) }
    end

    def post(path, payload)
      execute { |http| http.post(uri_for(path), body: payload) }
    end

    def put(path, payload)
      execute { |http| http.put(uri_for(path), body: payload) }
    end

    def patch(path, payload)
      execute { |http| http.patch(uri_for(path), body: payload) }
    end

    def delete(path)
      execute { |http| http.delete(uri_for(path)) }
    end

    private

    def uri_for(path)
      URI.parse("#{@base_url}#{path}")
    end

    def execute
      response = @http.with_retry { |http| yield(http) }
      Response.new(response.code.to_i, response.body)
    end
  end

  class Push
    USER_SCHEMA = "urn:ietf:params:scim:schemas:core:2.0:User"
    GROUP_SCHEMA = "urn:ietf:params:scim:schemas:core:2.0:Group"

    class << self
      def configured?
        ENV["SCIM_PUSH_URL"].present?
      end

      def instance
        @instance ||= new(Client.new(ENV.fetch("SCIM_PUSH_URL"), ENV["SCIM_PUSH_TOKEN"]))
      end

      def after_save(record)
        auto { |push| record.is_a?(::Authn::Group) ? push.push_group(record) : push.push_user(record) }
      end

      def after_delete(record)
        auto { |push| record.is_a?(::Authn::Group) ? push.delete_group(record) : push.delete_user(record) }
      end

      private

      def auto
        return unless configured?

        yield instance
      end
    end

    def initialize(client)
      @client = client
      @remote_users = {}
      @remote_groups = {}
    end

    def sync_all
      ::Authn::User.all.map { |user| safely("User", user[:username]) { push_user(user) } } +
        ::Authn::Group.all.map { |group| safely("Group", group.display_name) { push_group(group) } }
    end

    def push_user(user)
      push("User", "/Users", @remote_users, user.id, "userName", user[:username], user_payload(user))
    end

    def push_group(group)
      push("Group", "/Groups", @remote_groups, group.id, "displayName", group.display_name, group_payload(group))
    end

    def delete_user(user)
      remove("User", "/Users", @remote_users, user.id, "userName", user[:username])
    end

    def delete_group(group)
      remove("Group", "/Groups", @remote_groups, group.id, "displayName", group.display_name)
    end

    private

    def push(type, path, cache, key, attribute, value, payload)
      remote_id = cache[key] || find_remote(path, attribute, value)
      action = remote_id ? "update" : "create"
      response = remote_id ? @client.put("#{path}/#{remote_id}", payload) : @client.post(path, payload)
      remote_id ||= response.resource[:id]
      cache[key] = remote_id if remote_id
      result(type, value, action, response, remote_id)
    end

    def remove(type, path, cache, key, attribute, value)
      remote_id = cache.delete(key) || find_remote(path, attribute, value)
      return missing(type, value) if remote_id.nil?

      result(type, value, "delete", @client.delete("#{path}/#{remote_id}"), remote_id)
    end

    def find_remote(path, attribute, value)
      escaped = value.to_s.gsub('"') { '\\"' }
      response = @client.get(path, "filter" => %(#{attribute} eq "#{escaped}"))
      resources = response.resource[:Resources]
      resources.is_a?(Array) ? resources.dig(0, :id) : nil
    end

    def remote_user_id(local_id)
      @remote_users[local_id] ||= begin
        user = ::Authn::User.find(local_id)
        user && find_remote("/Users", "userName", user[:username])
      end
    end

    def user_payload(user)
      payload = {
        schemas: [USER_SCHEMA],
        userName: user[:username],
        active: user.active,
        emails: user.emails,
        roles: user.roles,
      }
      name = { givenName: user.given_name, familyName: user.family_name }.compact
      payload[:name] = name if name.present?
      payload[:externalId] = user.external_id if user.external_id
      payload
    end

    def group_payload(group)
      members = group.members.filter_map do |member|
        remote_id = remote_user_id(member[:value].to_s)
        next if remote_id.nil?

        { value: remote_id }
      end
      payload = {
        schemas: [GROUP_SCHEMA],
        displayName: group.display_name,
        members: members,
      }
      payload[:externalId] = group.external_id if group.external_id
      payload
    end

    def result(type, name, action, response, remote_id)
      { type: type, name: name, action: action, status: response.status, remote_id: remote_id, ok: response.success? }
    end

    def missing(type, name)
      { type: type, name: name, action: "delete", status: nil, remote_id: nil, ok: true }
    end

    def safely(type, name)
      yield
    rescue StandardError => error
      { type: type, name: name, ok: false, error: "#{error.class}: #{error.message}" }
    end
  end
end

module Authn
  module Store
    MUTEX = Mutex.new

    def self.path_for(name)
      File.join(__dir__, "../share/idp/#{name}.csv")
    end

    def self.write(path, headers, rows)
      MUTEX.synchronize do
        temp = File.join(File.dirname(path), ".#{File.basename(path)}.tmp")
        ::CSV.open(temp, "w", write_headers: true, headers: headers) do |csv|
          rows.each { |row| csv << row }
        end
        File.rename(temp, path)
      end
    end

    def self.read(path)
      return [] unless File.exist?(path)

      ::CSV.read(path, headers: true).map { |row| row.to_h.transform_keys(&:to_sym) }
    end

    def self.json_array(value)
      return value if value.is_a?(Array)
      return [] if value.blank?

      JSON.parse(value, symbolize_names: true)
    end

    def self.boolean(value)
      value.nil? ? true : value.to_s == "true"
    end

    def self.time_at(value)
      value.blank? ? Time.now : Time.parse(value.to_s)
    end
  end

  class User
    include ::BCrypt

    HEADERS = %w[id username password_digest active given_name family_name emails roles external_id created_at updated_at].freeze

    class << self
      def all
        @all ||= Store.read(Store.path_for("users")).map { |attributes| new(attributes) }
      end

      def save!
        Store.write(Store.path_for("users"), HEADERS, all.map(&:to_row))
      end

      def find(id)
        all.find do |user|
          user[:id] == id
        end
      end

      def find_by
        all.find do |user|
          yield user
        end
      end

      def find_by_email(email)
        find_by do |user|
          user.emails.any? { |x| x.is_a?(Hash) && x[:value] == email }
        end
      end

      def find_by_username(username)
        find_by do |user|
          user[:username] == username
        end
      end

      def login(params = {})
        user = find_by_username(params[:username])
        user&.valid_password?(params[:password]) ? user : nil
      end

      def scim_search(filter)
        Scim::Search.new(::Authn::User).for(filter)
      end

      def scim_mapper
        {
          "id" => :id,
          "user_name" => :username,
        }
      end

      def scim_attribute_for(name)
        scim_mapper[name.to_s.underscore]
      end

      def create!(username:, password: nil, active: true, given_name: nil, family_name: nil, emails: nil, roles: nil, external_id: nil)
        user = new(
          id: ::SecureRandom.uuid,
          username: username,
          password_digest: ::BCrypt::Password.create(password.presence || ::SecureRandom.hex(16)).to_s
        )
        user.assign_profile!(active: active, given_name: given_name, family_name: family_name, emails: emails, roles: roles, external_id: external_id)
        all << user
        save!
        ::Scim::Push.after_save(user)
        user
      end

      def delete!(id)
        index = all.find_index { |user| user.id == id }
        record = index && all.delete_at(index)
        if record
          save!
          ::Scim::Push.after_delete(record)
        end
        record
      end
    end

    attr_reader :id, :created_at, :updated_at
    attr_accessor :active, :given_name, :family_name, :emails, :roles, :external_id

    def initialize(attributes)
      attributes = attributes.transform_keys(&:to_sym)
      @attributes = attributes.slice(:id, :username, :password_digest)
      @id = self[:id]
      @active = Store.boolean(attributes[:active])
      @given_name = attributes[:given_name].presence
      @family_name = attributes[:family_name].presence
      @emails = Store.json_array(attributes[:emails])
      @roles = Store.json_array(attributes[:roles])
      @external_id = attributes[:external_id].presence
      @created_at = Store.time_at(attributes[:created_at])
      @updated_at = Store.time_at(attributes[:updated_at])
    end

    def [](attribute)
      @attributes.fetch(attribute.to_sym)
    end

    def to_row
      [
        id,
        self[:username],
        self[:password_digest],
        active,
        given_name,
        family_name,
        JSON.generate(emails),
        JSON.generate(roles),
        external_id,
        created_at.iso8601,
        updated_at.iso8601,
      ]
    end

    def assign_profile!(active:, given_name:, family_name:, emails:, roles:, external_id:)
      self.active = active.nil? ? true : active
      self.given_name = given_name
      self.family_name = family_name
      self.emails = emails || []
      self.roles = roles || []
      self.external_id = external_id
      self
    end

    def update!(username:, active: true, given_name: nil, family_name: nil, emails: nil, roles: nil, external_id: nil)
      @attributes[:username] = username
      assign_profile!(active: active, given_name: given_name, family_name: family_name, emails: emails, roles: roles, external_id: external_id)
      @updated_at = Time.now
      self.class.save!
      ::Scim::Push.after_save(self)
      self
    end

    def scim_profile
      {
        user_name: self[:username],
        active: active,
        name: { given_name: given_name, family_name: family_name },
        emails: emails,
        roles: roles,
        external_id: external_id,
      }
    end

    def apply_patch_state!(state)
      @attributes[:username] = state[:user_name] if state.key?(:user_name)
      self.active = state[:active] if state.key?(:active)
      name = state[:name]
      if name.is_a?(Hash)
        self.given_name = name[:given_name] if name.key?(:given_name)
        self.family_name = name[:family_name] if name.key?(:family_name)
      end
      self.emails = state[:emails] if state.key?(:emails)
      self.roles = state[:roles] if state.key?(:roles)
      self.external_id = state[:external_id] if state.key?(:external_id)
      @updated_at = Time.now
      self.class.save!
      ::Scim::Push.after_save(self)
      self
    end

    def primary_email
      entries = emails.select { |x| x.is_a?(Hash) }
      entry = entries.find { |x| x[:primary] } || entries.first
      entry && entry[:value]
    end

    def name_id_for(name_id_format)
      if name_id_format == Saml::Kit::Namespaces::EMAIL_ADDRESS
        primary_email
      else
        self[:id]
      end
    end

    def create_access_token
      ::Authz::JWT.new(
        sub: to_global_id.to_s,
        auth_time: Time.now.to_i,
        email: primary_email,
        username: self[:username],
      )
    end

    def create_id_token
      ::Authz::JWT.new(sub: to_global_id.to_s)
    end

    def assertion_attributes_for(request)
      {
        email: primary_email,
      }
    end

    def valid_password?(entered_password)
      ::BCrypt::Password.new(self[:password_digest]) == entered_password
    end

    def to_global_id
      ::GlobalID.new(
        ::URI::GID.build(
          app: "example",
          model_name: "User",
          model_id: id,
          params: {}
        )
      ).to_s
    end
  end

  class Group
    HEADERS = %w[id display_name members external_id created_at updated_at].freeze

    class << self
      def all
        @all ||= Store.read(Store.path_for("groups")).map { |attributes| new(**attributes) }
      end

      def save!
        Store.write(Store.path_for("groups"), HEADERS, all.map(&:to_row))
      end

      def find(id)
        all.find { |group| group.id == id }
      end

      def scim_search(filter)
        Scim::Search.new(::Authn::Group).for(filter)
      end

      def scim_mapper
        {
          "id" => :id,
          "display_name" => :display_name,
          "external_id" => :external_id,
        }
      end

      def scim_attribute_for(name)
        scim_mapper[name.to_s.underscore]
      end

      def create!(display_name:, members: nil, external_id: nil)
        group = new(id: ::SecureRandom.uuid, display_name: display_name, members: members, external_id: external_id)
        all << group
        save!
        ::Scim::Push.after_save(group)
        group
      end

      def delete!(id)
        index = all.find_index { |group| group.id == id }
        record = index && all.delete_at(index)
        if record
          save!
          ::Scim::Push.after_delete(record)
        end
        record
      end
    end

    attr_reader :id, :created_at, :updated_at
    attr_accessor :display_name, :members, :external_id

    def initialize(id:, display_name:, members: nil, external_id: nil, created_at: nil, updated_at: nil)
      @id = id
      @display_name = display_name
      @members = Store.json_array(members)
      @external_id = external_id.presence
      @created_at = Store.time_at(created_at)
      @updated_at = Store.time_at(updated_at)
    end

    def to_row
      [
        id,
        display_name,
        JSON.generate(members),
        external_id,
        created_at.iso8601,
        updated_at.iso8601,
      ]
    end

    def [](attribute)
      case attribute.to_sym
      when :id then id
      when :display_name then display_name
      when :external_id then external_id
      end
    end

    def update!(display_name:, members: nil, external_id: nil)
      self.display_name = display_name
      self.members = members || []
      self.external_id = external_id
      @updated_at = Time.now
      self.class.save!
      ::Scim::Push.after_save(self)
      self
    end

    def scim_profile
      {
        display_name: display_name,
        members: members,
        external_id: external_id,
      }
    end

    def apply_patch_state!(state)
      self.display_name = state[:display_name] if state.key?(:display_name)
      self.members = state[:members] if state.key?(:members)
      self.external_id = state[:external_id] if state.key?(:external_id)
      @updated_at = Time.now
      self.class.save!
      ::Scim::Push.after_save(self)
      self
    end
  end

  class OnDemandRegistry < Saml::Kit::DefaultRegistry
    def metadata_for(entity_id)
      found = super(entity_id)
      return found if found

      register_url(entity_id, verify_ssl: false)
      super(entity_id)
    end
  end

  class SessionsController
    include ::HTTPHelpers

    def call(env)
      request = Rack::Request.new(env)
      case request.request_method
      when Rack::GET
        case request.path
        when '/sessions/new'
          return get_login(request)
        end
      when Rack::POST
        case request.path
        when '/sessions'
          if (user = env['warden'].authenticate(:password))
            path = request.params["redirect_back"] ? request.params["redirect_back"] : "/"
            return http_redirect_to(path)
          else
            return http_redirect_to("/sessions/new")
          end
        when '/sessions/delete'
          request.env['warden'].logout
          return http_redirect_to('/')
        end
      end

      http_not_found
    end

    private

    def get_login(request)
      template = <<~ERB
      <!doctype html>
      <html lang="en" data-theme="light">
        <head>
          <title>IdP</title>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
          <meta name="color-scheme" content="light dark">
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
        </head>
        <body>
          <main class="container">
            <nav>
              <ul>
                <li><strong>IdP</strong></li>
              </ul>
            </nav>

            <form id="login-form" action="/sessions" method="post">
              <fieldset>
                <label>
                  Username
                  <input type="input" placeholder="Username" id="username" name="username" value="" />
                </label>
                <label>
                  Password
                  <input type="password" placeholder="Password" id="password" name="password" value="" />
                </label>
              </fieldset>

              <input type="hidden" name="redirect_back" value="<%= request.params["redirect_back"] %>" />
              <input type="submit" id="login-button" value="Login" />
            </form>
          </main>
        </body>
      </html>
      ERB
      html = ERB.new(template, trim_mode: '-').result(binding)
      [200, { 'Content-Type' => "text/html" }, [html]]
    end
  end

  class SAMLController
    include ::HTTPHelpers

    def initialize(scheme, host)
      Saml::Kit.configure do |x|
        x.entity_id = "#{scheme}://#{host}/saml/metadata.xml"
        x.registry = OnDemandRegistry.new
        x.generate_key_pair_for(use: :signing)
        x.generate_key_pair_for(use: :encryption)
      end

      @saml_metadata = Saml::Kit::Metadata.build do |builder|
        builder.contact_email = 'hi@example.com'
        builder.organization_name = "Acme, Inc"
        builder.organization_url = "#{scheme}://#{host}"
        builder.build_identity_provider do |x|
          x.add_single_sign_on_service("#{scheme}://#{host}/saml/new", binding: :http_post)
          x.name_id_formats = [Saml::Kit::Namespaces::PERSISTENT, Saml::Kit::Namespaces::EMAIL_ADDRESS]
          x.attributes << :email
        end
        builder.build_service_provider do |x|
          x.add_assertion_consumer_service("#{scheme}://#{host}/saml/acs", binding: :http_post)
          x.name_id_formats = [Saml::Kit::Namespaces::PERSISTENT, Saml::Kit::Namespaces::EMAIL_ADDRESS]
        end
      end
    end

    def call(env)
      request = Rack::Request.new(env)
      case request.request_method
      when Rack::GET
        case request.path
        when "/saml/continue"
          if current_user?(request)
            saml_params = request.session[:saml_params]
            return saml_post_back(request, current_user(request), saml_params)
          else
            return http_redirect_to("/sessions/new?redirect_back=/saml/continue")
          end
        when "/saml/metadata.xml"
          return http_ok(
            { 'Content-Type' => "application/samlmetadata+xml" },
            saml_metadata.to_xml(pretty: true)
          )
        end
      when Rack::POST
        case request.path
        when "/saml/new"
          saml_params = saml_params_from(request)

          if current_user?(request)
            return saml_post_back(request, current_user(request), saml_params)
          else
            request.session[:saml_params] = saml_params
            return http_redirect_to("/sessions/new?redirect_back=/saml/continue")
          end
        end
      end

      http_not_found
    end

    private

    attr_reader :saml_metadata

    def sign_assertions?
      ENV.fetch("SAML_SIGN", "true") != "false"
    end

    def saml_post_back(request, user, saml_params)
      saml_request = binding_for(request).deserialize(saml_params)

      @builder = nil
      url, saml_params = saml_request.response_for(
        user,
        binding: :http_post,
        relay_state: saml_params[:RelayState]
      ) do |builder|
        builder.embed_signature = false unless sign_assertions?
        @builder = builder
      end
      template = <<~ERB
      <!doctype html>
      <html lang="en" data-theme="light">
        <head>
          <title>IdP</title>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
          <meta name="color-scheme" content="light dark">
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
        </head>
        <body>
          <main class="container">
            <nav>
              <ul>
                <li><strong>IdP</strong></li>
              </ul>
            </nav>

            <h2>Recieved SAML Request</h2>
            <textarea readonly="readonly" disabled="disabled" cols=225 rows=8><%=- saml_request.to_xml(pretty: true) -%></textarea>

            <h2>Sending SAML Response (IdP -> SP)</h2>
            <textarea readonly="readonly" disabled="disabled" cols=225 rows=32><%=- @builder.build.to_xml(pretty: true) -%></textarea>
            <form id="postback-form" action="<%= url %>" method="post">
              <%- saml_params.each do |(key, value)| -%>
                <input type="hidden" name="<%= key %>" value="<%= value %>" />
              <%- end -%>
              <input id="submit-button" type="submit" value="Continue" />
            </form>
          </main>
        </body>
      </html>
      ERB
      erb = ERB.new(template, trim_mode: '-')
      html = erb.result(binding)
      [200, { 'Content-Type' => "text/html" }, [html]]
    end

    def saml_params_from(request)
      if request.post?
        {
          "SAMLRequest" => request.params["SAMLRequest"],
          "RelayState" => request.params["RelayState"],
        }
      else
        query_string = request.query_string
        on = query_string.include?("&amp;") ? "&amp;" : "&"
        Hash[query_string.split(on).map { |x| x.split("=", 2) }].symbolize_keys
      end
    end

    def binding_for(request)
      Saml::Kit::Bindings::HttpPost.new(location: "#{$scheme}://#{$host}/saml/new")
    end
  end

  class SCIMController
    include ::HTTPHelpers

    USER_ID_PATH = %r{\A/scim/v2/Users/(?<id>[^/]+)\z}
    GROUP_ID_PATH = %r{\A/scim/v2/Groups/(?<id>[^/]+)\z}
    SCHEMA_ID_PATH = %r{\A/scim/v2/Schemas/(?<id>.+)\z}
    CORE_ATTRIBUTES = %w[schemas id meta].freeze
    MAX_RESULTS = 200

    attr_reader :base_url

    def initialize(scheme, host)
      @base_url = "#{scheme}://#{host}/scim/v2"
      Scim::Kit::V2.configure do |config|
        config.service_provider_configuration(location: "#{base_url}/ServiceProviderConfig") do |x|
          x.documentation_uri = "#{base_url}/doc"
          x.add_authentication(:oauthbearertoken, primary: true)
          x.filter.supported = true
          x.filter.max_results = MAX_RESULTS
          x.bulk.supported = false
          x.bulk.max_operations = 0
          x.bulk.max_payload_size = 0
          x.sort.supported = true
          x.patch.supported = true
          x.meta.version = etag_for(x.meta.last_modified)
        end
        config.resource_type(id: 'User', location: "#{base_url}/ResourceTypes/User") do |x|
          x.name = 'User'
          x.schema = Scim::Kit::V2::Schemas::USER
          x.endpoint = "/Users"
        end
        config.schema(id: Scim::Kit::V2::Schemas::USER, name: "User", location: "#{base_url}/Schemas/#{Scim::Kit::V2::Schemas::USER}") do |schema|
          schema.add_attribute(name: :user_name) do |x|
            x.required = true
            x.uniqueness = :server
          end
          schema.add_attribute(name: :password) do |x|
            x.mutability = :write_only
            x.returned = :never
          end
          schema.add_attribute(name: :active, type: :boolean)
          schema.add_attribute(name: :name) do |x|
            x.add_attribute(name: :given_name)
            x.add_attribute(name: :family_name)
          end
          schema.add_attribute(name: :emails) do |x|
            x.multi_valued = true
            x.add_attribute(name: :value)
            x.add_attribute(name: :type)
            x.add_attribute(name: :primary, type: :boolean)
          end
          schema.add_attribute(name: :roles) do |x|
            x.multi_valued = true
            x.add_attribute(name: :value)
            x.add_attribute(name: :display)
            x.add_attribute(name: :type)
            x.add_attribute(name: :primary, type: :boolean)
          end
          schema.add_attribute(name: :external_id)
        end
        config.resource_type(id: 'Group', location: "#{base_url}/ResourceTypes/Group") do |x|
          x.name = 'Group'
          x.schema = Scim::Kit::V2::Schemas::GROUP
          x.endpoint = "/Groups"
        end
        config.schema(id: Scim::Kit::V2::Schemas::GROUP, name: "Group", location: "#{base_url}/Schemas/#{Scim::Kit::V2::Schemas::GROUP}") do |schema|
          schema.add_attribute(name: :display_name) do |x|
            x.required = true
          end
          schema.add_attribute(name: :members) do |x|
            x.multi_valued = true
            x.add_attribute(name: :value)
            x.add_attribute(name: :display)
            x.add_attribute(name: :type)
          end
          schema.add_attribute(name: :external_id)
        end
      end
    end

    def call(env)
      dispatch(Rack::Request.new(env))
    rescue JSON::ParserError
      scim_error(400, "Invalid JSON")
    rescue ::Scim::PatchError => error
      scim_error(error.status, error.message, scim_type: error.scim_type)
    rescue ::Scim::Kit::Error => error
      scim_error(400, error.message)
    end

    def dispatch(request)
      case request.request_method
      when Rack::GET
        case request.path
        when "/scim/v2/ServiceProviderConfig"
          return [200, scim_headers, [configuration.service_provider_configuration.to_json]]
        when "/scim/v2/ResourceTypes"
          return discovery_response(configuration.resource_types.values, ::Scim::Kit::V2::Schemas::RESOURCE_TYPE)
        when "/scim/v2/ResourceTypes/User"
          return [200, scim_headers, [configuration.resource_types["User"].to_json]]
        when "/scim/v2/ResourceTypes/Group"
          return [200, scim_headers, [configuration.resource_types["Group"].to_json]]
        when "/scim/v2/Schemas"
          return discovery_response(configuration.schemas.values, ::Scim::Kit::V2::Schemas::SCHEMA)
        when SCHEMA_ID_PATH
          return get_schema($~[:id])
        when "/scim/v2/Users"
          return get_users(request)
        when "/scim/v2/Groups"
          return get_groups(request)
        when USER_ID_PATH
          return get_user(request, $~[:id])
        when GROUP_ID_PATH
          return get_group(request, $~[:id])
        end
      when Rack::POST
        case request.path
        when "/scim/v2/Users"
          return post_users(request)
        when "/scim/v2/Groups"
          return post_groups(request)
        end
      when Rack::PUT
        case request.path
        when USER_ID_PATH
          return put_user(request, $~[:id])
        when GROUP_ID_PATH
          return put_group(request, $~[:id])
        end
      when Rack::DELETE
        case request.path
        when USER_ID_PATH
          return delete_record(::Authn::User, $~[:id], "User")
        when GROUP_ID_PATH
          return delete_record(::Authn::Group, $~[:id], "Group")
        end
      when Rack::PATCH
        case request.path
        when USER_ID_PATH
          return patch_user(request, $~[:id])
        when GROUP_ID_PATH
          return patch_group(request, $~[:id])
        end
      end

      http_not_found
    end

    private

    def configuration
      Scim::Kit::V2.configuration
    end

    def scim_headers
      { "Content-Type" => "application/scim+json" }
    end

    def get_users(request)
      render_collection(request, ::Authn::User) { |user| user_resource_for(user) }
    end

    def get_groups(request)
      render_collection(request, ::Authn::Group) { |group| group_resource_for(group) }
    end

    def render_collection(request, model, &builder)
      records = model.scim_search(request.params["filter"])
      records = sort_records(records, model, request.params["sortBy"], request.params["sortOrder"])
      paginate(records, request, &builder)
    end

    def sort_records(records, model, sort_by, sort_order)
      return records if sort_by.blank?

      attribute = model.scim_attribute_for(sort_by)
      return records if attribute.nil?

      sorted = records.sort_by { |record| record[attribute].to_s }
      sort_order == "descending" ? sorted.reverse : sorted
    end

    def paginate(records, request, &builder)
      start_index = [request.params["startIndex"].to_i, 1].max
      count_param = request.params["count"]
      count = count_param.nil? ? records.size : [count_param.to_i, 0].max
      page = records.drop(start_index - 1).first([count, MAX_RESULTS].min)
      resources = page.map { |record| select_attributes(builder.call(record).to_h, request) }

      list_response(resources, total: records.size, start_index: start_index)
    end

    def get_schema(id)
      schema = configuration.schemas[id]
      return scim_error(404, "Schema #{id} not found") if schema.nil?

      hash = with_schemas(schema.to_h, ::Scim::Kit::V2::Schemas::SCHEMA)
      [200, scim_headers, [JSON.pretty_generate(hash)]]
    end

    def get_user(request, id)
      user, error = find_record(::Authn::User, id, "User")
      return error if error

      hash = select_attributes(user_resource_for(user).to_h, request)
      [200, scim_headers, [JSON.generate(hash)]]
    end

    def get_group(request, id)
      group, error = find_record(::Authn::Group, id, "Group")
      return error if error

      hash = select_attributes(group_resource_for(group).to_h, request)
      [200, scim_headers, [JSON.generate(hash)]]
    end

    def select_attributes(hash, request)
      attributes = request.params["attributes"]
      excluded = request.params["excludedAttributes"]
      return hash if attributes.blank? && excluded.blank?

      if attributes.present?
        keep = CORE_ATTRIBUTES + attributes.split(",").map(&:strip)
        hash.select { |key, _| keep.include?(key.to_s) }
      else
        drop = excluded.split(",").map(&:strip) - CORE_ATTRIBUTES
        hash.reject { |key, _| drop.include?(key.to_s) }
      end
    end

    def post_users(request)
      params = params_from(request)
      return scim_error(400, "userName is required") if params[:username].blank?
      return scim_error(409, "User #{params[:username]} already exists", scim_type: "uniqueness") if username_taken?(params[:username])

      user = ::Authn::User.create!(**params)
      resource = user_resource_for(user)
      [201, scim_headers.merge("Location" => resource.meta.location), [JSON.generate(resource.to_h)]]
    end

    def post_groups(request)
      params = group_params_from(request)
      return scim_error(400, "displayName is required") if params[:display_name].blank?

      group = ::Authn::Group.create!(**params)
      resource = group_resource_for(group)
      [201, scim_headers.merge("Location" => resource.meta.location), [JSON.generate(resource.to_h)]]
    end

    def put_user(request, id)
      user, error = find_record(::Authn::User, id, "User")
      return error if error

      params = params_from(request).except(:password)
      return scim_error(400, "userName is required") if params[:username].blank?
      return scim_error(409, "User #{params[:username]} already exists", scim_type: "uniqueness") if username_taken?(params[:username], except_id: user.id)

      user.update!(**params)
      [200, scim_headers, [JSON.generate(user_resource_for(user).to_h)]]
    end

    def put_group(request, id)
      group, error = find_record(::Authn::Group, id, "Group")
      return error if error

      params = group_params_from(request)
      return scim_error(400, "displayName is required") if params[:display_name].blank?

      group.update!(**params)
      [200, scim_headers, [JSON.generate(group_resource_for(group).to_h)]]
    end

    def patch_user(request, id)
      user, error = find_record(::Authn::User, id, "User")
      return error if error

      body = parse_object(request)
      operations = body[:Operations]
      return scim_error(400, "Operations is required") if operations.blank?

      new_state = ::Scim::PatchOp.apply(user.scim_profile, operations)
      new_username = new_state[:user_name]
      return scim_error(400, "userName is required") if new_username.blank?
      if new_username != user[:username] && username_taken?(new_username, except_id: user.id)
        return scim_error(409, "User #{new_username} already exists", scim_type: "uniqueness")
      end

      user.apply_patch_state!(new_state)
      hash = select_attributes(user_resource_for(user).to_h, request)
      [200, scim_headers, [JSON.generate(hash)]]
    end

    def patch_group(request, id)
      group, error = find_record(::Authn::Group, id, "Group")
      return error if error

      body = parse_object(request)
      operations = body[:Operations]
      return scim_error(400, "Operations is required") if operations.blank?

      new_state = ::Scim::PatchOp.apply(group.scim_profile, operations, rules: ::Scim::PatchOp::GROUP_RULES)
      return scim_error(400, "displayName is required") if new_state[:display_name].blank?

      group.apply_patch_state!(new_state)
      hash = select_attributes(group_resource_for(group).to_h, request)
      [200, scim_headers, [JSON.generate(hash)]]
    end

    def find_record(model, id, label)
      record = model.find(id)
      return [nil, scim_error(404, "#{label} #{id} not found")] if record.nil?

      [record, nil]
    end

    def delete_record(model, id, label)
      record = model.delete!(id)
      return scim_error(404, "#{label} #{id} not found") if record.nil?

      [204, {}, []]
    end

    def parse_object(request)
      parsed = JSON.parse(request.body.read, symbolize_names: true)
      raise JSON::ParserError, "expected a JSON object" unless parsed.is_a?(Hash)

      parsed
    end

    def params_from(request)
      attributes = parse_object(request)
      {
        username: attributes[:userName],
        password: attributes[:password],
        active: attributes[:active],
        given_name: attributes.dig(:name, :givenName),
        family_name: attributes.dig(:name, :familyName),
        emails: attributes[:emails],
        roles: attributes[:roles],
        external_id: attributes[:externalId],
      }
    end

    def group_params_from(request)
      attributes = parse_object(request)
      {
        display_name: attributes[:displayName],
        members: attributes[:members],
        external_id: attributes[:externalId],
      }
    end

    def username_taken?(user_name, except_id: nil)
      existing = ::Authn::User.find_by_username(user_name)
      existing && existing.id != except_id
    end

    def user_resource_for(user)
      resource_for(user, schema: ::Scim::Kit::V2::Schemas::USER, collection: "Users")
    end

    def group_resource_for(group)
      resource_for(group, schema: ::Scim::Kit::V2::Schemas::GROUP, collection: "Groups")
    end

    def resource_for(record, schema:, collection:)
      ::Scim::Kit::V2::Resource.new(
        schemas: [configuration.schemas[schema]],
        location: "#{@base_url}/#{collection}/#{record.id}",
        attributes: record.scim_profile.merge(id: record.id)
      ) do |resource|
        resource.meta.created = record.created_at
        resource.meta.last_modified = record.updated_at
        resource.meta.version = etag_for(record.updated_at)
      end
    end

    def etag_for(time)
      %(W/"#{time.to_i}")
    end

    def discovery_response(resources, schema)
      hashes = resources.map { |resource| with_schemas(resource.to_h, schema) }
      list_response(hashes, total: hashes.size, start_index: 1)
    end

    def with_schemas(hash, schema)
      hash["schemas"] ||= [schema]
      hash
    end

    def list_response(resources, total:, start_index:)
      body = {
        schemas: [::Scim::Kit::V2::Messages::LIST_RESPONSE],
        totalResults: total,
        itemsPerPage: resources.size,
        startIndex: start_index,
        Resources: resources,
      }
      [200, scim_headers, [JSON.pretty_generate(body)]]
    end

    def scim_error(status, detail, scim_type: nil)
      body = {
        schemas: [::Scim::Kit::V2::Messages::ERROR],
        status: status.to_s,
        detail: detail,
      }
      body[:scimType] = scim_type if scim_type
      [status, scim_headers, [JSON.pretty_generate(body)]]
    end
  end
end

module Authz
  class JWT
    class << self
      # TODO:: validate signature
      def decode(encoded)
        _header, body, _signature = encoded
          .split('.', 3)
          .map { |x| JSON.parse(Base64.strict_decode64(x), symbolize_names: true) rescue {} }
        new(body)
      end
    end

    attr_reader :claims

    def initialize(claims)
      now = Time.now.to_i
      @claims = {
        iss: "#{$scheme}://#{$host}",
        iat: now,
        aud: "",
        nbf: now,
        jti: SecureRandom.uuid,
        exp: now + 3600,
      }.merge(claims)
    end

    def [](claim)
      claims.fetch(claim)
    end

    def active?
      now = Time.now.to_i
      self[:nbf] <= now && now < self[:exp]
    end

    def to_jwt
      [
        Base64.strict_encode64(JSON.generate(alg: "none")),
        Base64.strict_encode64(JSON.generate(claims)),
        ""
      ].join(".")
    end
  end

  class AuthorizationGrant
    class << self
      def all
        @all ||= []
      end

      def find_by(params)
        case params[:grant_type]
        when 'authorization_code'
          authorization_code_grant(params[:code], params[:code_verifier])
        when 'refresh_token'
          refresh_grant(params[:refresh_token])
        when 'client_credentials'
          client_credentials_grant(params)
        when 'password'
          password_grant(params[:username], params[:password])
        when "urn:ietf:params:oauth:grant-type:saml2-bearer" # RFC-7522
          saml_assertion_grant(params[:assertion])
        when 'urn:ietf:params:oauth:grant-type:jwt-bearer' # RFC7523
          jwt_bearer_grant(params)
        end
      end

      # TODO:: implement `code_verifier` param
      def authorization_code_grant(code, code_verifier)
        all.find do |grant|
          grant.active? && grant.code == code
        end
      end

      def refresh_grant(refresh_token)
        raise NotImplementedError
      end

      def client_credential_grant(params)
        raise NotImplementedError
      end

      def password_grant(username, password)
        raise NotImplementedError
      end

      def saml_assertion_grant(encoded_saml_assertion)
        xml = Base64.decode64(encoded_saml_assertion)
        # TODO:: Validate signature and prevent assertion reuse
        saml_assertion = Saml::Kit::Document.to_saml_document(xml)

        user = ::Authn::User.find_by_email(saml_assertion.name_id) ||
          ::Authn::User.find(saml_assertion.name_id)
        new(user, saml_assertion: saml_assertion)
      end

      def jwt_bearer_grant(params)
        raise NotImplementedError
      end

      def create!(user, params = {})
        new(user, params).tap do |grant|
          all << grant
        end
      end
    end

    attr_reader :code, :user, :params

    def initialize(user, params = {})
      @user = user
      @params = params
      @code = SecureRandom.uuid
      @exchanged_at = nil
    end

    def active?
      @exchanged_at.nil?
    end

    def inactive?
      !active?
    end

    def create_access_token
      raise "Invalid code" unless active?

      user.create_access_token.tap do
        @exchanged_at = Time.now
      end
    end

    def exchange
      {
        access_token: create_access_token.to_jwt,
        token_type: "Bearer",
        issued_token_type: "urn:ietf:params:oauth:token-type:access_token",
        expires_in: 3600,
        refresh_token: SecureRandom.hex(32)
      }.tap do |body|
        if params["scope"]&.include?("openid")
          body[:id_token] = user.create_id_token.to_jwt
        end
      end
    rescue StandardError => error
      {
        error: error.message,
        error_description: error.backtrace,
      }
    end
  end

  class OAuthController
    include ::HTTPHelpers

    def call(env)
      request = Rack::Request.new(env)

      case request.request_method
      when Rack::GET
        case request.path
        when "/oauth/authorize/continue"
          if current_user?(request)
            return get_authorize(request.session[:oauth_params])
          end
        when "/oauth/authorize" # RFC-6749
          oauth_params = request.params.slice('client_id', 'scope', 'redirect_uri', 'response_mode', 'response_type', 'state', 'code_challenge_method', 'code_challenge')
          if current_user?(request)
            return get_authorize(oauth_params)
          else
            request.session[:oauth_params] = oauth_params
            return http_redirect_to("/sessions/new?redirect_back=/oauth/authorize/continue")
          end
        else
          return http_not_found
        end
      when Rack::POST
        case request.path
        when "/oauth/authorize" # RFC-6749
          return post_authorize(request)
        when "/oauth/introspect" # RFC-7662
          params = request.content_type == "application/json" ? JSON.parse(request.body.read, symbolize_names: true) : Hash[URI.decode_www_form(request.body.read)].transform_keys(&:to_sym)
          return post_introspect(params.slice(:token, :token_type_hint))
        when "/oauth/token" # RFC-6749
          params = request.content_type == "application/json" ? JSON.parse(request.body.read, symbolize_names: true) : Hash[URI.decode_www_form(request.body.read)].transform_keys(&:to_sym)
          grant = AuthorizationGrant.find_by(params)

          return [404, { "Content-Type" => "application/json" }, [JSON.pretty_generate(error: 404, error_description: "Not Found")]] if grant.nil? || grant.inactive?
          return [200, { "Content-Type" => "application/json" }, [JSON.pretty_generate(grant.exchange)]]
        when "/oauth/revoke" # RFC-7009
          # TODO:: Revoke the JWT token and make it ineligible for usage
          return http_not_found
        else
          return http_not_found
        end
      end
      http_not_found
    end

    private

    def post_introspect(params)
      token = ::Authz::JWT.decode(params[:token])
      return [200, { "Content-Type" => "application/json" }, [JSON.pretty_generate(token.claims.merge(active: token.active?))]]
    end

    def get_authorize(oauth_params)
      template = <<~ERB
      <!doctype html>
      <html lang="en" data-theme="light">
        <head>
          <title>IdP</title>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
          <meta name="color-scheme" content="light dark">
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
        </head>
        <body>
          <main class="container">
            <nav>
              <ul>
                <li><strong>IdP</strong></li>
              </ul>
            </nav>

            <h1>Authorize?</h1>
            <p>Client ID: <%= oauth_params['client_id'] %></p>
            <form id="authorize-form" action="/oauth/authorize" method="post">
              <input type="hidden" name="client_id" value="<%= oauth_params['client_id'] %>" />
              <input type="hidden" name="scope" value="<%= oauth_params['scope'] %>" />
              <input type="hidden" name="redirect_uri" value="<%= oauth_params['redirect_uri'] %>" />
              <input type="hidden" name="response_mode" value="<%= oauth_params['response_mode'] %>" />
              <input type="hidden" name="response_type" value="<%= oauth_params['response_type'] %>" />
              <input type="hidden" name="state" value="<%= oauth_params['state'] %>" />
              <input type="hidden" name="code_challenge_method" value="<%= oauth_params['code_challenge_method'] %>" />
              <input type="hidden" name="code_challenge" value="<%= oauth_params['code_challenge'] %>" />
              <input id="submit-button" type="submit" value="Authorize" />
            </form>
          </main>
        </body>
      </html>
      ERB
      html = ERB.new(template, trim_mode: '-').result(binding)
      [200, { 'Content-Type' => "text/html" }, [html]]
    end

    def post_authorize(request)
      params = request.params.slice('client_id', 'redirect_uri', 'response_type', 'response_mode', 'state', 'code_challenge_method', 'code_challenge', 'scope')
      grant = AuthorizationGrant.create!(current_user(request), params)
      case params['response_type']
      when 'code'
        case params['response_mode']
        when 'fragment'
          return [302, { 'Location' => "#{params['redirect_uri']}#code=#{grant.code}&state=#{params['state']}" }, []]
        when 'query'
          return [302, { 'Location' => "#{params['redirect_uri']}?code=#{grant.code}&state=#{params['state']}" }, []]
        else
          # TODO:: form post
        end
      when 'token'
        return http_not_found
      else
        return http_not_found
      end
    end
  end
end

class IdentityProvider
  include ::HTTPHelpers

  def call(env)
    request = Rack::Request.new(env)

    case request.request_method
    when Rack::GET
      case request.path
      when '/'
        if current_user?(request)
          return get_dashboard(request)
        else
          return http_redirect_to("/sessions/new")
        end
      when '/.well-known/openid-configuration'
        return openid_metadata
      when '/.well-known/oauth-authorization-server'
        return oauth_metadata
      when '/.well-known/webfinger' # RFC-7033
        return http_not_found
      else
        return http_not_found
      end
    end
    http_not_found
  end

  private

  def get_dashboard(request)
    template = <<~ERB
      <!doctype html>
      <html lang="en" data-theme="light">
        <head>
          <title>IdP</title>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
          <meta name="color-scheme" content="light dark">
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
        </head>
        <body>
          <main class="container">
            <nav>
              <ul>
                <li><strong>IdP</strong></li>
              </ul>
              <ul>
                <li><a href="/">Home</a></li>
                <li>
                  <form action="/sessions/delete" method="post">
                    <input type="submit" value="logout" />
                  </form>
                </li>
              </ul>
            </nav>

            <h1> Hello, <%= current_user(request)[:username] %></h1>
          </main>
        </body>
      </html>
    ERB
    erb = ERB.new(template, trim_mode: '-')
    html = erb.result(binding)
    [200, { 'Content-Type' => "text/html" }, [html]]
  end

  # GET /.well-known/oauth-authorization-server
  def oauth_metadata
    [200, { 'Content-Type' => "application/json" }, [JSON.pretty_generate({
      issuer: "#{$scheme}://#{$host}/.well-known/oauth-authorization-server",
      authorization_endpoint: "#{$scheme}://#{$host}/oauth/authorize",
      token_endpoint: "#{$scheme}://#{$host}/oauth/token",
      jwks_uri: "", # RFC-7517
      registration_endpoint: "", # RFC-7591
      scopes_supported: ["openid", "profile", "email"],
      response_types_supported: ["code", "code id_token", "id_token", "token id_token"],
      response_modes_supported: ["query", "fragment", "form_post"],
      grant_types_supported: ["authorization_code", "implicit"], # RFC-7591
      token_endpoint_auth_methods_supported: ["client_secret_basic"], # RFC-7591
      token_endpoint_auth_signing_alg_values_supported: ["RS256"],
      service_documentation: "",
      ui_locales_supported: ["en-US"],
      op_policy_uri: "",
      op_tos_uri: "",
      revocation_endpoint: "#{$scheme}://#{$host}/oauth/revoke", # RFC-7009
      revocation_endpoint_auth_methods_supported: ["client_secret_basic"],
      revocation_endpoint_auth_signing_alg_values_supported: ["RS256"],
      introspection_endpoint: "#{$scheme}://#{$host}/oauth/introspect", # RFC-7662
      introspection_endpoint_auth_methods_supported: ["client_secret_basic"],
      introspection_endpoint_auth_signing_alg_values_supported: ["RS256"],
      code_challenge_methods_supported: [], # RFC-7636
    })]]
  end

  # GET /.well-known/openid-configuration
  def openid_metadata
    [200, { 'Content-Type' => "application/json" }, [JSON.pretty_generate({
      issuer: "#{$scheme}://#{$host}/.well-known/oauth-authorization-server",
      authorization_endpoint: "#{$scheme}://#{$host}/oauth/authorize",
      token_endpoint: "#{$scheme}://#{$host}/oauth/token",
      userinfo_endpoint: "#{$scheme}://#{$host}/oidc/user/",
      jwks_uri: "", # RFC-7517
      registration_endpoint: nil,
      scopes_supported: ["openid", "profile", "email"],
      response_types_supported: ["code", "code id_token", "id_token", "token id_token"],
      response_modes_supported: ["query", "fragment", "form_post"],
      grant_types_supported: ["authorization_code", "implicit"], # RFC-7591
      acr_values_supported: [],
      subject_types_supported: ["pairwise", "public"],
      id_token_signing_alg_values_supported: ["RS256"],
      id_token_encryption_alg_values_supported: [],
      id_token_encryption_enc_values_supported: [],
      userinfo_signing_alg_values_supported: ["RS256"],
      userinfo_encryption_alg_values_supported: [],
      userinfo_encryption_enc_values_supported: [],
      request_object_signing_alg_values_supported: ["none", "RS256"],
      request_object_encryption_alg_values_supported: [],
      request_object_encryption_enc_values_supported: [],
      token_endpoint_auth_methods_supported: ["client_secret_post", "client_secret_basic", "client_secret_jwt", "private_key_jwt"],
      token_endpoint_auth_signing_alg_values_supported: [],
      display_values_supported: [],
      claim_types_supported: ["normal", "aggregated", "distributed"],
      claims_supported: [
        "acr",
        "auth_time",
        "email",
        "email_verified",
        "family_name",
        "given_name",
        "iss",
        "locale",
        "name",
        "nickname",
        "picture",
        "profile",
        "sub",
        "website"
      ],
      service_documentation: nil,
      claims_locales_supported: [],
      ui_locales_supported: ["en-US"],
      claims_parameter_supported: false,
      request_parameter_supported: false,
      request_uri_paramater_supported: false,
      require_request_uri_registration: false,
      op_policy_uri: "",
      op_tos_uri: "",
    })]]
  end
end

if __FILE__ == $0
  if ARGV[0] == "push"
    abort("SCIM_PUSH_URL is required") unless Scim::Push.configured?

    results = Scim::Push.instance.sync_all
    failed = results.count { |entry| !entry[:ok] }
    exit(failed.zero? ? 0 : 1)
  end

  app = Rack::Builder.new do
    use Rack::CommonLogger
    use Rack::Reloader
    use Rack::Session::Cookie, { domain: $host.split(":", 2)[0], path: "/", secret: SecureRandom.hex(64) }
    use ::Warden::Manager do |config|
      config.default_scope = :user
      config.default_strategies :password
    end

    map "/oauth" do
      run ::Authz::OAuthController.new
    end

    map "/saml" do
      run Authn::SAMLController.new($scheme, $host)
    end

    map "/scim" do
      run Authn::SCIMController.new($scheme, $host)
    end

    map "/sessions" do
      run Authn::SessionsController.new
    end
    run IdentityProvider.new
  end.to_app

  options = { app: app, Port: $port }
  if $scheme == "https"
    require "webrick/https"

    options[:SSLEnable] = true

    cert_path = ENV.fetch("SSL_CERT_FILE", File.join(__dir__, "../etc/ssl/localhost.pem"))
    key_path = ENV.fetch("SSL_KEY_FILE", File.join(__dir__, "../etc/ssl/localhost-key.pem"))

    if File.exist?(cert_path) && File.exist?(key_path)
      options[:SSLCertificate] = OpenSSL::X509::Certificate.new(File.read(cert_path))
      options[:SSLPrivateKey] = OpenSSL::PKey::RSA.new(File.read(key_path))
    else
      options[:SSLCertName] = [["CN", $host.split(":", 2)[0]]]
    end
  end

  Rackup::Server.start(**options)
end
